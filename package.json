{
  "name": "@suwatte/toolchain",
  "version": "1.1.0",
  "description": "Build, validate, and test Source plugins for Suwatte",
  "homepage": "https://suwatte.mantton.com/developers/introduction/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suwatte/Toolchain.git"
  },
  "bugs": {
    "url": "https://suwatte.mantton.com/help/",
    "email": "help@mantton.com"
  },
  "funding": "https://www.patreon.com/mantton",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "suwatte": "bin/suwatte.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./emulator": {
      "types": "./dist/emulator/index.d.ts",
      "default": "./dist/emulator/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "default": "./dist/validate/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\"",
    "build": "tsc && npm run copy",
    "build:clean": "npm run clean && npm run build",
    "copy": "node -e \"require('fs').cpSync('./src/templates','./dist/templates',{recursive:true})\"",
    "test": "npm run build:clean && node --test tests/**/*.test.cjs",
    "prepack": "npm run build:clean",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "suwatte",
    "source-plugin",
    "toolchain",
    "typescript"
  ],
  "author": {
    "name": "Mantton",
    "email": "mantton.official@gmail.com",
    "url": "https://mantton.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^4",
    "commander": "^12.1.0",
    "esbuild": "^0.25.0",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "serve-handler": "^6.1.5",
    "typescript": "^5.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.4.0",
    "@types/serve-handler": "^6.1.4"
  },
  "peerDependencies": {
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs"
}
